{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER,1433;Database=YOUR_DATABASE;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "GENERATE_A_RANDOM_BASE64_KEY",
    "Issuer": "AkkWebService",
    "Audience": "AkkFrontend",
    "ExpirationMinutes": 480
  },
  "AdminUser": {
    "Username": "YOUR_ADMIN_USERNAME",
    "PasswordHash": "YOUR_BCRYPT_PASSWORD_HASH"
  }
}
